    "@svgr/core": "^5.5.0",
    "@svgr/plugin-jsx": "^5.5.0",
    "axios": "^0.21.1",
    "babel-plugin-object-styles-to-template": "^0.2.2",
    "clipboard-copy": "^4.0.1",
    "css-to-tailwindcss": "^1.0.4",
    "evergreen-ui": "^4.28.0",
    "formik": "^2.2.9",
    "htmltojsx": "^0.3.0",
    "is-svg": "^4.3.1",
    "json-to-zod": "^1.1.2",
    "json_typegen_wasm": "^0.7.0",
    "lodash": "^4.17.21",
    "markdown": "^0.5.0",
    "next": "10.2.3",
    "nprogress": "^0.2.0",
    "postcss": "^8.3.5",
    "postcss-js": "^3.0.3",
    "postcss-nested": "^6.0.0",
    "prettier": "^1.18.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-dropzone": "^11.0.1",
    "recast": "^0.20.5",
    "svgo": "^1.3.2",
    "text-encoding-utf-8": "^1.0.2",
    "ts-to-zod": "^1.11.0",
    "typescript": "4.3.4"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.170",
    "@types/node": "^15.12.5",
    "@types/prettier": "^2.3.0",
    "@types/react": "^17.0.11",
    "@types/svgo": "^1.3.3",
    "husky": "^4.2.5",
    "imagemin-lint-staged": "^0.4.0",
    "lint-staged": "^11.0.0",
    "patch-package": "^6.4.7",
